# Go
bin/
*.exe
*.test
*.out

# Env
.env

# TLS certs generated by scripts/gen-certs.sh — dev-only, never committed
deploy/certs/

# Phase 7 chaos-test bind mounts (deploy/docker-compose.yml's fleet/control
# services): bulk-issued registration tokens and claimed fleet device
# credentials — see test/chaos/README.md.
test/chaos/data/*
test/chaos/fleet-data/*
!test/chaos/data/.gitkeep
!test/chaos/fleet-data/.gitkeep

# Chaos-test run output (test/chaos/*.sh, render_charts.py) — reproducible
# by re-running the scripts against a live stack, tied to whatever machine
# and fleet size generated it. The report (P10) assembles from a
# deliberate run's output, not from whatever's sitting here. The rendered
# chart PNGs are the exception: docs/phase10-report.md embeds them
# directly, so they need to be committed for the report to actually
# render on GitHub — only the raw CSVs (reproducible, run-specific) stay
# ignored.
test/chaos/results/*
!test/chaos/results/.gitkeep
!test/chaos/results/charts/
!test/chaos/results/charts/*.png

# Phase 8 hardening drill output (test/hardening/*.sh) — same reasoning as
# test/chaos/results/ above, plus these can contain actual pg_dump backups
# of whatever's in the dev stack at drill time.
test/hardening/results/*
!test/hardening/results/.gitkeep

# Node (web/console, web/sensor-client — Phase 5/1)
web/**/node_modules/
web/**/.next/
web/**/dist/
web/**/.env.local

# ESP32 firmware (Phase 9) — config.h/ca_cert.h hold this machine's WiFi
# creds, claim token, and dev CA (deploy/certs/ca.pem, itself gitignored
# above); same .example -> real-file pattern as .env.example -> .env.
firmware/esp32/src/config.h
firmware/esp32/src/ca_cert.h
firmware/esp32/.pio/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
