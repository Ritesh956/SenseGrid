# Copy to .env (git-ignored) before running `make docker-up`.
# Nothing here is a real secret — this is a local dev stack.

SENSEGRID_ENV=dev
LOG_LEVEL=info

# --- TimescaleDB ---
POSTGRES_USER=sensegrid
POSTGRES_PASSWORD=sensegrid-dev
POSTGRES_DB=sensegrid

# --- Redis ---
REDIS_ADDR=redis:6379

# --- NATS ---
NATS_URL=nats://nats:4222

# --- MQTT ---
MQTT_BROKER_URL=tls://mosquitto:8883

# --- TLS ---
# Path inside each Go service container where deploy/certs is mounted
# read-only, so clients can verify the dev CA when Phase 1+ code starts
# dialing mosquitto/timescaledb over TLS.
TLS_CA_FILE=/certs/ca.pem
