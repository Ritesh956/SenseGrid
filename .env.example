# Copy to .env (git-ignored) before running `make docker-up`.
# Nothing here is a real secret — this is a local dev stack.

SENSEGRID_ENV=dev
LOG_LEVEL=info

# --- TimescaleDB ---
POSTGRES_USER=sensegrid
POSTGRES_PASSWORD=sensegrid-dev
POSTGRES_DB=sensegrid

# --- Redis ---
REDIS_ADDR=redis:6379

# --- NATS ---
NATS_URL=nats://nats:4222

# --- MQTT ---
MQTT_BROKER_URL=tls://mosquitto:8883
# Admin credentials for the dynamic-security plugin (see
# deploy/mosquitto/entrypoint.sh and internal/dynsec). cmd/control uses
# these to provision per-device broker credentials at claim time.
MOSQUITTO_ADMIN_USER=admin
MOSQUITTO_ADMIN_PASSWORD=sensegrid-admin-dev
# cmd/ingest's own broker account (Phase 2) — control provisions it at
# bootstrap with the "bridge" role (subscribe across every device's
# telemetry), ingest connects as it. Not a per-device credential, so
# unlike those it lives here rather than being claimed at runtime.
MQTT_BRIDGE_USERNAME=ingest-bridge
MQTT_BRIDGE_PASSWORD=sensegrid-bridge-dev

# --- TLS ---
# Path inside each Go service container where deploy/certs is mounted
# read-only, so clients can verify the dev CA when Phase 1+ code starts
# dialing mosquitto/timescaledb over TLS.
TLS_CA_FILE=/certs/ca.pem

# --- Tracing (Phase 2) ---
# OTLP/gRPC endpoint every service exports spans to; see the jaeger
# service in docker-compose.yml. Empty disables tracing (internal/tracing
# no-ops cleanly), so this only needs to be unset for a service you're
# deliberately running outside the compose network.
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317

# --- Windowed stream processing & anomaly detection (Phase 3) ---
# cmd/processor's rules file path is set directly in docker-compose.yml
# (bind-mounted from ./rules.yaml so edits hot-reload live — see
# internal/rules.Watcher), not here. These control the shared sliding
# window every rule in rules.yaml evaluates against — see internal/window
# and internal/rules' doc comment on why window shape is process-wide
# rather than per-rule. Uncomment to override the defaults in
# internal/config/config.go.
# WINDOW_MAX_COUNT=100
# WINDOW_MAX_AGE=30s
# WINDOW_EWMA_ALPHA=0.3
# WINDOW_REGISTRY_TTL=10m
# WINDOW_REGISTRY_SWEEP_INTERVAL=1m
# RULES_RELOAD_INTERVAL=5s
