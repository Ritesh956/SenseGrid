{
  "uid": "sensegrid-fleet-health",
  "title": "SenseGrid / Fleet health",
  "tags": ["sensegrid"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active devices",
      "description": "Claimed devices whose last_seen is within the shadow-drift staleness threshold (cmd/control).",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sensegrid_control_active_devices", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Console WS clients connected",
      "description": "Open GET /v1/ws connections (cmd/control).",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sensegrid_control_ws_clients_connected", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Alerts firing right now (approx.)",
      "description": "fired - resolved over the last hour. Approximate: alerts fired before this window aren't counted.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "increase(sensegrid_processor_alerts_fired_total[1h]) - increase(sensegrid_processor_alerts_resolved_total[1h])",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Ingest messages / sec",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sensegrid_ingest_messages_received_total[1m])", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Messages received / sec (ingest → processor)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sensegrid_ingest_messages_received_total[1m])", "legendFormat": "ingest received", "refId": "A" },
        { "expr": "rate(sensegrid_processor_messages_consumed_total[1m])", "legendFormat": "processor consumed", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Alert fire / resolve rate",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(sensegrid_processor_alerts_fired_total[5m])", "legendFormat": "fired", "refId": "A" },
        { "expr": "rate(sensegrid_processor_alerts_resolved_total[5m])", "legendFormat": "resolved", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    }
  ]
}
