// Copy to ca_cert.h (gitignored) before building. Paste the contents of
// your dev CA (deploy/certs/ca.pem, generated by scripts/gen-certs.sh) as
// the PEM string below — same trust root every other SenseGrid client
// uses (internal/tlsutil.FromCAFile). Regenerated per machine, so it can't
// be committed as a fixed value the way the rest of this firmware is.
#pragma once

static const char SENSEGRID_CA_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
paste deploy/certs/ca.pem here
-----END CERTIFICATE-----
)EOF";
